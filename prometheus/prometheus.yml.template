global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: django
    metrics_path: __DJANGO_METRICS_PATH__
    static_configs:
      - targets:
          - __DJANGO_METRICS_TARGET__
        labels:
          app: __DJANGO_APP_LABEL__

  - job_name: postgres
    static_configs:
      - targets:
          - postgres_exporter:9187

  # Celery task metrics (Flower is UI-only; not scraped — basic auth would block /metrics).
  - job_name: celery
    static_configs:
      - targets:
          - celery_exporter:9808
