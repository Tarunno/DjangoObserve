# Copy to .env and fill in real values. Never commit .env.

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
GF_SERVER_ROOT_URL=http://localhost:3000
# Bind Grafana only on localhost by default (use a reverse proxy in prod)
GRAFANA_HOST_PORT=127.0.0.1:3000

# --- Prometheus ---
# Retention for local TSDB
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=10GB
# Expose Prometheus UI locally only
PROMETHEUS_HOST_PORT=127.0.0.1:9090

# --- Alertmanager ---
ALERTMANAGER_HOST_PORT=127.0.0.1:9093
# Slack webhook (optional). Leave empty to skip Slack notifications.
ALERTMANAGER_SLACK_WEBHOOK_URL=
ALERTMANAGER_SLACK_CHANNEL=#alerts

# --- Postgres exporter ---
# Example: postgresql://monitor_user:secret@db.internal:5432/mydb?sslmode=require
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://postgres:password@db:5432/postgres?sslmode=disable

# --- Redis / Celery ---
# Flower + celery-exporter broker URL
CELERY_BROKER_URL=redis://:password@redis:6379/1
# Flower basic auth: user:password (comma-separated for multiple users)
FLOWER_BASIC_AUTH=admin:change-me-flower-password

# --- Django metrics scrape target (host:port reachable from Prometheus container) ---
# If Django runs on the host machine while monitoring runs in Docker:
#   DJANGO_METRICS_TARGET=host.docker.internal:8000
# If Django is on the same Compose network:
#   DJANGO_METRICS_TARGET=web:8000
DJANGO_METRICS_TARGET=host.docker.internal:8000
DJANGO_METRICS_PATH=/metrics
DJANGO_APP_LABEL=django
